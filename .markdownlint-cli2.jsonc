{
  "config": {
    "default": false,
    "no-trailing-spaces": true,
    "no-multiple-blanks": { "maximum": 2 },
    "no-duplicate-header": { "siblings_only": true },
    "emphasis-style": { "style": "asterisk" }
  },
  "globs": [
    "**/*.md",
    "!node_modules/**",
    "!upstream/adguard/**",
    "!uBOL Filter Converter/upstream/**"
  ]
}
